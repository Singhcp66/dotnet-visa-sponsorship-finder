{
  "manifest_version": 3,
  "name": "Visa Sponsorship Finder — .NET Jobs",
  "version": "1.0.0",
  "description": "Find .NET/C# jobs that sponsor work permits across Europe and Canada. Every verdict shows the sentence it came from. Exports to Excel.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.se/*",
    "https://*.thehub.io/*",
    "https://arbetsformedlingen.se/*",
    "https://*.arbetsformedlingen.se/*",
    "https://jobsearch.api.jobtechdev.se/*",
    "https://*.blocket.se/*",
    "https://*.academicwork.se/*",
    "https://*.jobbsafari.se/*",
    "https://*.thelocal.de/*",
    "https://*.stepstone.de/*",
    "https://*.stepstone.nl/*",
    "https://*.welcometothejungle.com/*",
    "https://*.irishjobs.ie/*",
    "https://*.jobs.ie/*",
    "https://*.monster.co.uk/*",
    "https://*.reed.co.uk/*",
    "https://*.totaljobs.com/*",
    "https://*.pracuj.pl/*",
    "https://*.infojobs.net/*",
    "https://*.jobbird.com/*",
    "https://*.finn.no/*",
    "https://*.jobindex.dk/*",
    "https://*.duunitori.fi/*",
    "https://*.otta.com/*",
    "https://*.workinstartups.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.se/*",
        "https://*.thehub.io/*",
        "https://arbetsformedlingen.se/*",
        "https://*.arbetsformedlingen.se/*",
        "https://*.jobbsafari.se/*",
        "https://*.academicwork.se/*",
        "https://*.stepstone.de/*",
        "https://*.stepstone.nl/*",
        "https://*.welcometothejungle.com/*",
        "https://*.irishjobs.ie/*",
        "https://*.jobs.ie/*",
        "https://*.monster.co.uk/*",
        "https://*.reed.co.uk/*",
        "https://*.totaljobs.com/*",
        "https://*.pracuj.pl/*",
        "https://*.finn.no/*",
        "https://*.jobindex.dk/*",
        "https://*.otta.com/*"
      ],
      "js": [
        "js/countries.js",
        "js/lexicon.js",
        "js/sponsorship.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}